# Public hostname (used by Caddy for TLS).
# For local dev, use "localhost" and Caddy will serve plain HTTP.
VINYLSTREAM_HOSTNAME=localhost

# Icecast passwords. CHANGE THESE before exposing publicly.
ICECAST_SOURCE_PASSWORD=changeme-source
ICECAST_RELAY_PASSWORD=changeme-relay
ICECAST_ADMIN_PASSWORD=changeme-admin

# Icecast admin user (default "admin" is fine)
ICECAST_ADMIN_USER=admin

# Max listeners advertised by Icecast
ICECAST_MAX_LISTENERS=50

# Stream display metadata
STREAM_NAME=VinylStream
STREAM_DESCRIPTION=Lossless audio livestream
STREAM_GENRE=Various

# Backend internal addresses (rarely need changing)
VINYLSTREAM_LISTEN=:8080
ICECAST_URL=http://icecast:8000
ICECAST_MOUNT=/live.flac
ICECAST_POLL_INTERVAL=5s

# SQLite path inside the container
VINYLSTREAM_DB=/data/vinylstream.db

# Host port bindings. Tweak if these conflict with other services
# on the host (Unraid often has 8080 used by something else).
# Set VINYLSTREAM_BIND=0.0.0.0 if you want to hit the backend over
# LAN without going through your reverse proxy (handy for first-boot
# verification before nginx is wired up).
VINYLSTREAM_BIND=127.0.0.1
VINYLSTREAM_PORT=8080
ICECAST_BIND=0.0.0.0
ICECAST_PORT=8000
