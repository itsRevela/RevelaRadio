# Default: auto-detect text, normalize to LF in the repo.
* text=auto eol=lf

# Files that MUST stay LF (run inside Linux containers).
*.sh        text eol=lf
Dockerfile  text eol=lf
*.tmpl      text eol=lf
Caddyfile   text eol=lf

# Go uses LF by convention.
*.go        text eol=lf

# Web/config files: LF.
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf

# Treat known binaries explicitly.
*.png       binary
*.jpg       binary
*.ico       binary
